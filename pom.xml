<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>co.ufps.clinica</groupId><artifactId>clinica-backend</artifactId><version>1.0-SNAPSHOT</version><packaging>pom</packaging>
  <name>Clinica Backend</name>
  <modules><module>clinica-entities</module><module>clinica-usecases</module><module>clinica-interface-adapters</module><module>clinica-frameworks-drivers</module><module>clinica-api</module></modules>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <quarkus.platform.version>3.8.2</quarkus.platform.version>
    <byte-buddy.version>1.18.16</byte-buddy.version>
    <netty.version>4.1.138.Final</netty.version>
  </properties>
  <dependencyManagement><dependencies>
    <!-- Align all Netty modules to a Java 25-safe 4.1 release; Quarkus 3.8.2 manages 4.1.107.Final. -->
    <dependency><groupId>io.netty</groupId><artifactId>netty-bom</artifactId><version>${netty.version}</version><type>pom</type><scope>import</scope></dependency>
    <dependency><groupId>io.quarkus.platform</groupId><artifactId>quarkus-bom</artifactId><version>${quarkus.platform.version}</version><type>pom</type><scope>import</scope></dependency>
    <!-- Quarkus 3.8 manages Byte Buddy 1.14.x, which cannot parse Java 25 class files. -->
    <dependency><groupId>net.bytebuddy</groupId><artifactId>byte-buddy</artifactId><version>${byte-buddy.version}</version></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId><version>10.17.2</version></dependency>
  </dependencies></dependencyManagement>
  <build><pluginManagement><plugins>
    <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.12.1</version><configuration><release>17</release><parameters>true</parameters></configuration></plugin>
    <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version></plugin>
    <plugin><artifactId>maven-jar-plugin</artifactId><version>3.5.0</version></plugin>
    <plugin><groupId>io.quarkus.platform</groupId><artifactId>quarkus-maven-plugin</artifactId><version>${quarkus.platform.version}</version><configuration><warnIfBuildGoalMissing>false</warnIfBuildGoalMissing></configuration></plugin>
  </plugins></pluginManagement></build>
</project>
